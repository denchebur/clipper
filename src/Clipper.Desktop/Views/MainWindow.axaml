<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Clipper.Desktop.ViewModels"
        x:Class="Clipper.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Clipper"
        Width="900" Height="640" MinWidth="640" MinHeight="480">

  <Window.Styles>
    <!-- Подписи полей в настройках -->
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="12,0,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Grid.form > :is(Control)">
      <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style Selector="Grid.form > TextBlock.hint">
      <Setter Property="Margin" Value="12,4,0,4" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">

    <!-- ─── Верх: стримы и кнопки ─── -->
    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="Стримы (Twitch или YouTube), пишутся одновременно" VerticalAlignment="Center" />
        <Button Grid.Column="1" Margin="8,0,0,0" Content="{Binding StartStopText}" Command="{Binding StartStopCommand}"
                MinWidth="100" HorizontalContentAlignment="Center" Classes="accent" />
        <Button Grid.Column="2" Margin="8,0,0,0" Content="✂ Клип со всех" Command="{Binding ClipNowCommand}" />
      </Grid>

      <ScrollViewer MaxHeight="150">
        <ItemsControl ItemsSource="{Binding Streams}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StreamRow">
              <Grid ColumnDefinitions="*,170,Auto,Auto" Margin="0,2">
                <TextBox Text="{Binding Url}" Watermark="https://www.twitch.tv/имя_канала"
                         IsEnabled="{Binding !$parent[Window].((vm:MainViewModel)DataContext).IsRunning}" />
                <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis" Opacity="0.8" />
                <Button Grid.Column="2" Content="✂" ToolTip.Tip="Клип сейчас с этого стрима" Margin="4,0,0,0"
                        IsVisible="{Binding IsRecording}"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ClipStreamCommand}"
                        CommandParameter="{Binding}" />
                <Button Grid.Column="3" Content="✕" ToolTip.Tip="Убрать стрим" Margin="4,0,0,0"
                        IsVisible="{Binding !$parent[Window].((vm:MainViewModel)DataContext).IsRunning}"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveStreamCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <Button Content="+ Добавить стрим" Command="{Binding AddStreamCommand}" IsVisible="{Binding !IsRunning}" />
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8" />
    </StackPanel>

    <TabControl>

      <!-- ─── Клипы ─── -->
      <TabItem Header="Клипы">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="Открыть папку клипов" Command="{Binding OpenClipsFolderCommand}" />
            <TextBlock Text="{Binding Options.ClipsDir}" Classes="hint" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Clips}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ClipRow">
                <Grid ColumnDefinitions="80,190,60,*,Auto,Auto,Auto">
                  <TextBlock Text="{Binding Time}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Source}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Length}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Status}" />
                  <Button Grid.Column="4" Content="Открыть" IsVisible="{Binding IsDone}" Margin="4,0,0,0"
                          Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).OpenClipCommand}"
                          CommandParameter="{Binding}" />
                  <Button Grid.Column="5" Content="В Shorts" IsVisible="{Binding CanUpload}" Margin="4,0,0,0"
                          Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).UploadClipCommand}"
                          CommandParameter="{Binding}" />
                  <Button Grid.Column="6" Content="▶ YouTube" IsVisible="{Binding YouTubeUrl, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="4,0,0,0"
                          Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).OpenYouTubeCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>

      <!-- ─── Настройки ─── -->
      <TabItem Header="Настройки">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="0,8,8,8">
            <Grid Classes="form" ColumnDefinitions="220,200,*"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

              <TextBlock Grid.Row="0" Classes="label" Text="Качество" />
              <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Qualities}"
                        SelectedItem="{Binding Options.Quality}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="0" Grid.Column="2" Classes="hint" Text="best — максимальное доступное" />

              <TextBlock Grid.Row="1" Classes="label" Text="Секунд до всплеска" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Options.SecondsBefore}" />
              <TextBlock Grid.Row="1" Grid.Column="2" Classes="hint" Text="чат реагирует с опозданием, берём с запасом" />

              <TextBlock Grid.Row="2" Classes="label" Text="Секунд после всплеска" />
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Options.SecondsAfter}" />

              <TextBlock Grid.Row="3" Classes="label" Text="Макс. длина клипа, с" />
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Options.MaxClipSeconds}" />
              <TextBlock Grid.Row="3" Grid.Column="2" Classes="hint" Text="если всплески идут подряд и склеиваются" />

              <TextBlock Grid.Row="4" Classes="label" Text="Поправка на задержку, с" />
              <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Options.LatencyCorrectionSeconds}" />
              <TextBlock Grid.Row="4" Grid.Column="2" Classes="hint" Text="увеличьте, если момент в клипе начинается слишком поздно" />

              <TextBlock Grid.Row="5" Classes="label" Text="Вертикальное видео" />
              <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding VerticalModes}"
                        SelectedItem="{Binding Options.Vertical.Mode}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="5" Grid.Column="2" Classes="hint" Text="blur — размытый фон, crop — обрезать центр" />

              <TextBlock Grid.Row="6" Classes="label" Text="Размер (ширина × высота)" />
              <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <TextBox Text="{Binding Options.Vertical.Width}" Width="90" />
                <TextBlock Text="×" VerticalAlignment="Center" />
                <TextBox Text="{Binding Options.Vertical.Height}" Width="90" />
              </StackPanel>

              <TextBlock Grid.Row="7" Classes="label" Text="Папка записей" />
              <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Options.RecordingsDir}" />

              <TextBlock Grid.Row="8" Classes="label" Text="Папка клипов" />
              <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Options.ClipsDir}" />

              <TextBlock Grid.Row="9" Classes="label" Text="ffmpeg" />
              <TextBox Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Options.FfmpegPath}"
                       Watermark="ffmpeg или полный путь к программе" />

              <TextBlock Grid.Row="10" Classes="label" Text="streamlink" />
              <TextBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Options.StreamlinkPath}"
                       Watermark="streamlink или полный путь к программе" />

              <TextBlock Grid.Row="11" Classes="label" Text="Адрес для расширения" />
              <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding Options.ListenUrl}" />
              <TextBlock Grid.Row="11" Grid.Column="2" Classes="hint" Text="тот же адрес укажите в настройках расширения" />

              <TextBlock Grid.Row="12" Classes="label" Text="Хранить записи, мин" />
              <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding Options.KeepRecordingsMinutes}" />
              <TextBlock Grid.Row="12" Grid.Column="2" Classes="hint" Text="старые записи стримов удаляются (0 — не удалять); клипы остаются всегда" />

              <TextBlock Grid.Row="13" Classes="label" Text="Новый файл записи каждые, мин" />
              <TextBox Grid.Row="13" Grid.Column="1" Text="{Binding Options.RotateRecordingMinutes}" />
              <TextBlock Grid.Row="13" Grid.Column="2" Classes="hint" Text="чтобы длинный стрим не копился в одном огромном файле" />
            </Grid>

            <TextBlock Text="Субтитры" FontSize="18" Margin="0,8,0,0" />
            <Grid Classes="form" ColumnDefinitions="220,200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Classes="label" Text="Делать субтитры" />
              <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding Options.Subtitles.Enabled}" />
              <TextBlock Grid.Row="0" Grid.Column="2" Classes="hint" Text="речь распознаётся на компьютере, бесплатно" />

              <TextBlock Grid.Row="1" Classes="label" Text="Вшивать в видео" />
              <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding Options.Subtitles.BurnIn}" />
              <TextBlock Grid.Row="1" Grid.Column="2" Classes="hint" Text="файл .srt рядом с клипом сохраняется всегда" />

              <TextBlock Grid.Row="2" Classes="label" Text="Модель Whisper" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding WhisperModels}"
                        SelectedItem="{Binding Options.Subtitles.Model}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="2" Grid.Column="2" Classes="hint" Text="base — быстро; small — точнее для русского, но медленнее. Скачается при первом клипе" />

              <TextBlock Grid.Row="3" Classes="label" Text="Язык речи" />
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Options.Subtitles.Language}" />
              <TextBlock Grid.Row="3" Grid.Column="2" Classes="hint" Text="auto — определить сам, или код: ru, en, uk…" />

              <TextBlock Grid.Row="4" Classes="label" Text="Символов в строке / шрифт" />
              <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <TextBox Text="{Binding Options.Subtitles.MaxLineChars}" Width="90" />
                <TextBlock Text="/" VerticalAlignment="Center" />
                <TextBox Text="{Binding Options.Subtitles.FontSize}" Width="90" />
              </StackPanel>

              <TextBlock Grid.Row="5" Classes="label" Text="Папка моделей" />
              <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Options.Subtitles.ModelsDir}" />
            </Grid>

            <TextBlock Text="YouTube Shorts" FontSize="18" Margin="0,8,0,0" />
            <Grid Classes="form" ColumnDefinitions="220,200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Classes="label" Text="Аккаунт Google" />
              <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Войти через Google" Command="{Binding GoogleSignInCommand}" IsVisible="{Binding !IsGoogleSignedIn}" />
                <Button Content="Выйти" Command="{Binding GoogleSignOutCommand}" IsVisible="{Binding IsGoogleSignedIn}" />
                <TextBlock Text="{Binding GoogleStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>

              <TextBlock Grid.Row="1" Classes="label" Text="Загружать автоматически" />
              <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding Options.YouTube.AutoUpload}" />
              <TextBlock Grid.Row="1" Grid.Column="2" Classes="hint" Text="выключено — загрузка кнопкой «В Shorts» в списке клипов" />

              <TextBlock Grid.Row="2" Classes="label" Text="Доступ к видео" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding PrivacyOptions}"
                        SelectedItem="{Binding Options.YouTube.Privacy}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="2" Grid.Column="2" Classes="hint" Text="private — только вы; unlisted — по ссылке; public — всем" />

              <TextBlock Grid.Row="3" Classes="label" Text="Название" />
              <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Options.YouTube.TitleTemplate}"
                       Watermark="{}{text} — начало речи, {channel}, {date}" />

              <TextBlock Grid.Row="4" Classes="label" Text="Описание" VerticalAlignment="Top" Margin="0,10,12,0" />
              <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Options.YouTube.DescriptionTemplate}"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />

              <TextBlock Grid.Row="5" Classes="label" Text="Теги (через запятую)" />
              <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Options.YouTube.Tags}" />

              <TextBlock Grid.Row="6" Classes="label" Text="Ключ Google (client_secret)" />
              <Grid Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding Options.YouTube.ClientSecretsPath}" />
                <Button Grid.Column="1" Content="Выбрать…" Command="{Binding PickClientSecretsCommand}" Margin="8,0,0,0" />
              </Grid>
            </Grid>
            <TextBlock Classes="hint" Margin="0" Text="Как получить ключ Google — в README, раздел «YouTube Shorts». Пока приложение Google не прошло проверку, YouTube публикует загруженные через API видео только как private." />

            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Content="Сохранить настройки" Command="{Binding SaveSettingsCommand}" />
              <TextBlock Classes="hint" Text="{Binding SettingsPath, StringFormat='Файл: {0}'}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ─── Лог ─── -->
      <TabItem Header="Лог">
        <DockPanel>
          <Button DockPanel.Dock="Bottom" Content="Очистить" Command="{Binding ClearLogCommand}" Margin="0,8,0,0" />
          <ListBox ItemsSource="{Binding Log}" FontFamily="Consolas,Menlo,monospace" FontSize="12" />
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
